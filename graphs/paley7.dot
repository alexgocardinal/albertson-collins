digraph tournament {
  graph [layout=circo];
  node [style=filled, shape=circle];
  0 [fillcolor="#f6b95d", label="0"];
  1 [fillcolor="#f6b95d", label="1"];
  2 [fillcolor="#f6b95d", label="2"];
  3 [fillcolor="#f6b95d", label="3"];
  4 [fillcolor="#8fc4ea", label="4"];
  5 [fillcolor="#8fc4ea", label="5"];
  6 [fillcolor="#8fc4ea", label="6"];
  0 -> 1;
  0 -> 2;
  0 -> 4;
  1 -> 2;
  1 -> 3;
  1 -> 5;
  2 -> 3;
  2 -> 4;
  2 -> 6;
  3 -> 0;
  3 -> 4;
  3 -> 5;
  4 -> 1;
  4 -> 5;
  4 -> 6;
  5 -> 0;
  5 -> 2;
  5 -> 6;
  6 -> 0;
  6 -> 1;
  6 -> 3;
}
